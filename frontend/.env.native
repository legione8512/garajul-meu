# Read by `vite build --mode native`, which the `build:native` script runs.
#
# Vite loads `.env.[mode]` and nothing else for a named mode, so this file does
# NOT inherit from `.env.production` - the API origin has to be stated here as
# well, and that duplication is the price of the mechanism rather than an
# oversight. If the two ever disagree, the native application talks to a
# different server than the web one and nothing says so.
#
# Committed on purpose, under the same exception as `.env.production` and
# guarded by the same test. Every VITE_ value is inlined into the bundle and
# shipped inside the APK, where anybody can unzip it - the prefix means public,
# and an APK is not a secret.
VITE_CLIENT=native
VITE_API_BASE_URL=https://api.cyber-half.com