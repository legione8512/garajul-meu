<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 13 and later. Declared here because the push-notifications plugin
        does NOT declare it - checked in its own AndroidManifest.xml on
        2026-09-01, which registers a messaging service and nothing else. The
        documentation says only that an application "is required to call
        checkPermissions() and requestPermissions()" and leaves this unsaid.

        Without the declaration those calls have nothing to ask for: the runtime
        prompt never appears, the permission reads as denied, and screen 18 tells
        the person to change a setting they were never offered. It would have
        been found on a handset, at the worst possible moment.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
