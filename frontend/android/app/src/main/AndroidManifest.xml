<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
            Stops Firebase minting an FCM token at launch and uploading it
            before anybody has been asked anything. The token is a durable
            identifier for this handset, and the default is to create one the
            first time the app runs.

            Not a restriction on the feature: the plugin sets auto-init back on
            inside getToken(), so this only moves the minting from launch to the
            moment somebody has said yes on screen 18. reportDevice() is written
            around exactly that.

            Analytics is switched off beside it because the Firebase SDK pulled
            in by the messaging plugin collects on its own, and this application
            asks for no analytics consent and has nowhere to show one.

            The iOS twin is FirebaseMessagingAutoInitEnabled in
            ios/App/App/Info.plist, and the two must agree.
        -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 13 and later. Added on 2026-09-01 because @capacitor/push-
        notifications did not declare it, and kept on 2026-09-05 after the swap
        to @capacitor-firebase/messaging, whose manifest does. The merger unions
        the two, so the duplicate costs nothing.

        Kept rather than deleted because what this application is allowed to ask
        of the phone should be readable here, not inferred from a dependency -
        and because the failure it prevents is silent. Without the declaration
        checkPermissions() and requestPermissions() have nothing to ask for: no
        runtime prompt appears, the permission reads as denied, and screen 18
        tells the person to change a setting they were never offered. That is
        found on a handset, at the worst possible moment, and a plugin dropping
        the line in a future version would put us back there.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Two permissions @capacitor/local-notifications declares for itself, and
        this application uses neither. It posts a notification only at the moment
        one arrives, never at a time in the future.

        SCHEDULE_EXACT_ALARM is the one that would have cost something. From
        Android 14, Google Play asks for a declaration justifying it and grants it
        to little besides alarm clocks and calendars, so carrying it unused is a
        review problem arriving through a dependency. RECEIVE_BOOT_COMPLETED lets
        the plugin put scheduled notifications back after a restart, and there
        are none to put back.

        Removing them does not change what the plugin does here, and that was
        read in its source on 2026-09-18 rather than assumed: a notification with
        no schedule goes straight to NotificationManager.notify(), and
        foregroundNotifications.ts marks each one isExactNotification false,
        without which schedule() would open the Alarms and reminders settings
        screen on Android 12 and later every time a push arrived with the
        application open.

        The merged manifest in app/build/intermediates is where to check that
        both are gone after a plugin upgrade.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
</manifest>
